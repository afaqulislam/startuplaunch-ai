# Copy this file to `.env` and fill in real values.

# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_generate_a_random_value

# REQUIRED for the agent swarm to run (Groq API key).
GROQ_API_KEY=change_me

# Optional. Model used by the agent swarm. Defaults to openai/gpt-oss-120b
# (fast, enforced JSON output, no live web search). The compound models
# (groq/compound, groq/compound-mini) enable built-in web search but can hit
# intermittent 413 "Request Entity Too Large" errors on Groq's free tier.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. SQLite by default; use a Postgres URL for production, e.g.
#   postgresql+asyncpg://user:pass@host:5432/startuplaunch
DATABASE_URL=sqlite+aiosqlite:///./startuplaunch.db

# Optional. Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# Optional. Comma-separated emails to promote to the 'admin' role on startup
# (case-insensitive). Without this, every account is the default 'user' role.
# ADMIN_EMAILS=founder@example.com

# Optional. Set to true in production so the session cookie is sent with
# Secure + SameSite=None (requires HTTPS). Defaults to off (SameSite=Lax) for
# local development over http://localhost.
# COOKIE_SECURE=true

# Optional. Enables Redis-backed rate limiting (shared across multi-worker
# deploys). In-memory sliding-window limiting is used when unset. Use rediss://
# for TLS connections. Requires the 'redis' package.
REDIS_URL=
