# Copy this file to `.env` and fill in real values.

# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_generate_a_random_value

# REQUIRED for the agent swarm to run (Groq API key).
GROQ_API_KEY=change_me

# Optional. SQLite by default; use a Postgres URL for production, e.g.
#   postgresql+asyncpg://user:pass@host:5432/startuplaunch
DATABASE_URL=sqlite+aiosqlite:///./startuplaunch.db

# Optional. Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000
